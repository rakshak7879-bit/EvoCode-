# Evo Code configuration. Copy to `.env` (project root or backend/) and adjust.
# Never commit a real `.env` file.

# --- LLM (optional) -----------------------------------------------------------
# Leave every key empty to run fully offline with deterministic local analysis.
# Evo Code then labels the mode "DEMO / LOCAL ANALYSIS" and skips the LLM-only
# sub-agents; nothing else changes.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# auto = DeepSeek, then OpenAI, then local | deepseek | openai | mock
EVO_LLM_PROVIDER=auto
EVO_LLM_TIMEOUT_SECONDS=45

# --- Storage ------------------------------------------------------------------
# SQLite memory database, uploads and extracted working copies live here.
# Relative paths are resolved from the project root.
EVO_DATA_DIR=.evo-data

# --- Limits -------------------------------------------------------------------
EVO_MAX_UPLOAD_MB=50
EVO_MAX_EXTRACTED_MB=200
EVO_MAX_FILE_KB=512
EVO_MAX_FILES=3000
EVO_AGENT_TIMEOUT_SECONDS=120

# --- Solving issues (the model-facing harness) --------------------------------
# `./evo solve` and `./evo check` run the target repository's own test suite.
# This is the only place Evo Code executes code from a repository: the command
# comes from Evo Code's detection table, runs without a shell in its own process
# group, with a timeout and no network helpers. Set to false to forbid it
# (planning and code location still work; the gate then reports "unknown").
EVO_ALLOW_TEST_EXECUTION=true
EVO_TEST_TIMEOUT_SECONDS=300

# --- Demo / UX ----------------------------------------------------------------
# Minimum time (ms) each Brain stage stays visible so the orchestration can be
# observed in the dashboard. 0 = run as fast as possible (tests use 0).
EVO_PACING_MS=350
# Allows `edit`, `fix`, `apply` and `write` to change code. In analyze/fix flows
# that only ever touches Evo Code's working copy, never your original files.
EVO_ALLOW_SOURCE_EDITS=true
# Comma-separated agent names to force-fail, for demonstrating graceful
# degradation. Lead agents ("walkthrough") and sub-agents ("security.secrets",
# "explainer.flows") both work. Leave empty normally.
EVO_SIMULATE_AGENT_FAILURE=

# --- Server -------------------------------------------------------------------
EVO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EVO_LOG_LEVEL=INFO
# text | json
EVO_LOG_FORMAT=text
# Optional: raises GitHub rate limits for GitHub URL analysis.
GITHUB_TOKEN=
