# Evo Code configuration. Copy to `.env` (project root or backend/) and adjust.
# Never commit a real `.env` file.

# --- LLM (optional) -----------------------------------------------------------
# Leave OPENAI_API_KEY empty to run fully offline with deterministic local
# analysis. The UI labels that mode "DEMO / LOCAL ANALYSIS".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# auto = OpenAI when a key is present, otherwise local | openai | mock
EVO_LLM_PROVIDER=auto
EVO_LLM_TIMEOUT_SECONDS=45

# --- Storage ------------------------------------------------------------------
# SQLite memory database, uploads and extracted working copies live here.
# Relative paths are resolved from the project root.
EVO_DATA_DIR=.evo-data

# --- Limits -------------------------------------------------------------------
EVO_MAX_UPLOAD_MB=50
EVO_MAX_EXTRACTED_MB=200
EVO_MAX_FILE_KB=512
EVO_MAX_FILES=3000
EVO_AGENT_TIMEOUT_SECONDS=120

# --- Demo / UX ----------------------------------------------------------------
# Minimum time (ms) each Brain stage stays visible so the orchestration can be
# observed in the dashboard. 0 = run as fast as possible (tests use 0).
EVO_PACING_MS=350
# Enables the source viewer's "Simulate a code change" (edits Evo Code's
# working copy of the repository only, never your original files).
EVO_ALLOW_SOURCE_EDITS=true
# Comma-separated agent names to force-fail, e.g. "walkthrough".
# Used to demonstrate graceful degradation. Leave empty normally.
EVO_SIMULATE_AGENT_FAILURE=

# --- Server -------------------------------------------------------------------
EVO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EVO_LOG_LEVEL=INFO
# text | json
EVO_LOG_FORMAT=text
# Optional: raises GitHub rate limits for GitHub URL analysis.
GITHUB_TOKEN=
